/-!
# Partition-Based Hole-Carving Topology Framework for Chen–Wang (`Defs.D_0007` → `Specs.L_0031`)

In Chen–Wang (arXiv:1809.03763v2, Sections 3, 6, 7), the base space `X = ℕ → Q`
is equipped with the laminar clopen partitions `W n x := H q (n + 1) (code (n + 1) (q.symm ∘ x))`
from `Defs.D_0007`, and the topology `τ` is obtained by carving out allowed "hole"
sets `D ∈ Holes y` (`y ∉ D`) from `W n y`.

This file formalizes this exact mechanism in Lean 4 (zero `sorry`, standard axioms only):

1. `HoleSystem Y`: a monotone partition family `W : ℕ → Y → Set Y` (`⋂ n, W n x = {x}`)
   together with a coherent hole family `Holes : Y → Set (Set Y)`.
2. `HoleSystem.toTopologicalSpace`: constructs `τ : TopologicalSpace Y` whose basic
   open neighborhoods at `y` are `W n y \ D` (`D ∈ Holes y`), proving that every
   `W n y` is **automatically clopen** in `τ` and `(Y, τ)` is `T1Space`.
3. `HoleSystem.not_Tinf_of_sep_and_escape`: directly concludes
   `¬ MSpace.Goals.Tinf_M3_imp_M1` (via `Specs.L_0031`, `R_0010`, `L_0032`, `R_0009`,
   `L_0029`, `L_0004`) from base-level hole separation and an escape witness.
4. `H_partition_base`: instantiates the partition axioms on `Defs.D_0007.H q (n + 1)`
   for any `q : ℕ ≃ α`.
-/

namespace Research.ChenWangHoleSystem

open MSpace Set Topology

/-- A partition-based hole-carving neighborhood specification on `Y`. -/
structure HoleSystem (Y : Type) where
  W : ℕ → Y → Set Y
  mem_W : ∀ n y, y ∈ W n y
  W_dec : ∀ n y, W (n + 1) y ⊆ W n y
  W_part : ∀ n x y, y ∈ W n x → W n y = W n x
  W_inter : ∀ y, (⋂ n, W n y) = {y}
  Holes : Y → Set (Set Y)
  empty_mem : ∀ y, ∅ ∈ Holes y
  not_mem_hole : ∀ y, ∀ D ∈ Holes y, y ∉ D
  union_mem : ∀ y, ∀ D₁ ∈ Holes y, ∀ D₂ ∈ Holes y, D₁ ∪ D₂ ∈ Holes y
  coherent : ∀ n y, ∀ D ∈ Holes y, ∀ z ∈ W n y \ D,
    ∃ m, n ≤ m ∧ ∃ D' ∈ Holes z, W m z \ D' ⊆ W n y \ D

namespace HoleSystem

variable {Y : Type} (H : HoleSystem Y)

/-- Helper: monotonicity of `W n y` for `m ≤ n`. -/
theorem W_anti {m n : ℕ} (hmn : m ≤ n) (y : Y) : H.W n y ⊆ H.W m y := by
  induction hmn with
  | refl => exact Subset.rfl
  | step _ ih => exact (H.W_dec _ y).trans ih

/-- Basic neighborhoods at `y`: sets of the form `W n y \ D` with `D ∈ Holes y`. -/
def BasicNhd (y : Y) (S : Set Y) : Prop :=
  ∃ n, ∃ D ∈ H.Holes y, S = H.W n y \ D

/-- Topology `τ` generated by the hole-carving basic neighborhoods `W n y \ D`. -/
@[instance_reducible]
def toTopologicalSpace : TopologicalSpace Y where
  IsOpen O := ∀ y ∈ O, ∃ n, ∃ D ∈ H.Holes y, H.W n y \ D ⊆ O
  isOpen_univ := fun y _ => ⟨0, ∅, H.empty_mem y, subset_univ _⟩
  isOpen_inter := fun O₁ O₂ hO₁ hO₂ y ⟨hy1, hy2⟩ => by
    obtain ⟨n₁, D₁, hD₁, h1⟩ := hO₁ y hy1
    obtain ⟨n₂, D₂, hD₂, h2⟩ := hO₂ y hy2
    refine ⟨max n₁ n₂, D₁ ∪ D₂, H.union_mem y D₁ hD₁ D₂ hD₂, ?_⟩
    intro z ⟨hzW, hzD⟩
    refine ⟨h1 ⟨H.W_anti (le_max_left n₁ n₂) y hzW, fun h => hzD (Or.inl h)⟩,
            h2 ⟨H.W_anti (le_max_right n₁ n₂) y hzW, fun h => hzD (Or.inr h)⟩⟩
  isOpen_sUnion := fun F hF y ⟨O, hOF, hyO⟩ => by
    obtain ⟨n, D, hD, hsub⟩ := hF O hOF y hyO
    exact ⟨n, D, hD, hsub.trans (subset_sUnion_of_mem hOF)⟩

/-- Every basic neighborhood `W n y \ D` is open in `H.toTopologicalSpace`. -/
theorem isOpen_basic (n : ℕ) (y : Y) {D : Set Y} (hD : D ∈ H.Holes y) :
    @IsOpen Y H.toTopologicalSpace (H.W n y \ D) := by
  intro z hz
  obtain ⟨m, _, D', hD', hsub⟩ := H.coherent n y D hD z hz
  exact ⟨m, D', hD', hsub⟩

/-- Every partition piece `W n y` is **clopen** in `H.toTopologicalSpace`. -/
theorem W_clopen (n : ℕ) (y : Y) :
    @IsOpen Y H.toTopologicalSpace (H.W n y) ∧ @IsClosed Y H.toTopologicalSpace (H.W n y) := by
  let : TopologicalSpace Y := H.toTopologicalSpace
  constructor
  · have hEq : H.W n y = H.W n y \ ∅ := (sdiff_empty).symm
    rw [hEq]
    exact H.isOpen_basic n y (H.empty_mem y)
  · rw [← isOpen_compl_iff]
    intro x hx
    refine ⟨n, ∅, H.empty_mem x, ?_⟩
    intro z ⟨hzWx, _⟩ hzWy
    have h1 : H.W n z = H.W n x := H.W_part n x z hzWx
    have h2 : H.W n z = H.W n y := H.W_part n y z hzWy
    have hxy : H.W n x = H.W n y := h1.symm.trans h2
    exact hx (hxy ▸ H.mem_W n x)

/-- `(Y, H.toTopologicalSpace)` is automatically `T1Space`. -/
theorem t1Space : @T1Space Y H.toTopologicalSpace := by
  let : TopologicalSpace Y := H.toTopologicalSpace
  refine ⟨fun y => ?_⟩
  rw [← H.W_inter y]
  exact isClosed_iInter fun n => (H.W_clopen n y).2

/-- Closure characterization in `H.toTopologicalSpace`. -/
theorem mem_closure_iff_hole {S : Set Y} {z : Y} :
    z ∈ @closure Y H.toTopologicalSpace S ↔
      ∀ n, ∀ D ∈ H.Holes z, ((H.W n z \ D) ∩ S).Nonempty := by
  let : TopologicalSpace Y := H.toTopologicalSpace
  rw [mem_closure_iff]
  constructor
  · intro h n D hD
    exact h (H.W n z \ D) (H.isOpen_basic n z hD) ⟨H.mem_W n z, H.not_mem_hole z D hD⟩
  · intro h O hO hzO
    obtain ⟨n, D, hD, hsub⟩ := hO z hzO
    obtain ⟨w, hw1, hw2⟩ := h n D hD
    exact ⟨w, hsub hw1, hw2⟩

/-- End-to-end refutation of `MSpace.Goals.Tinf_M3_imp_M1` from a `HoleSystem` with
a stratifiable clopen `g`-function (for instance `g := H.W` or a refinement) and an
escape witness at `y₀`. -/
theorem not_Tinf_of_sep_and_escape
    (g : ℕ → Y → Set Y)
    (hg_open : ∀ n y, @IsOpen Y H.toTopologicalSpace (g n y) ∧ y ∈ g n y)
    (hg_dec : ∀ n y, g (n + 1) y ⊆ g n y)
    (hg_sep : ∀ F : Set Y, @IsClosed Y H.toTopologicalSpace F → ∀ x ∉ F,
      ∃ n, ∃ m, ∃ D ∈ H.Holes x, ∀ y ∈ F, Disjoint (H.W m x \ D) (g n y))
    (y₀ : Y)
    (hesc : ∀ 𝓥 : Set (Set Y),
      (∀ V ∈ 𝓥, @IsOpen Y H.toTopologicalSpace V ∧ y₀ ∈ V) →
      (∀ n, ∀ D ∈ H.Holes y₀, ∃ V ∈ 𝓥, V ⊆ H.W n y₀ \ D) →
      ∃ 𝒢 ⊆ 𝓥, ∃ z : Y,
        (∀ n, ∀ D ∈ H.Holes z, ∃ V ∈ 𝒢, ((H.W n z \ D) ∩ V).Nonempty) ∧
        (∀ V ∈ 𝒢, ∃ n, ∃ D ∈ H.Holes z, Disjoint (H.W n z \ D) V)) :
    ¬ MSpace.Goals.Tinf_M3_imp_M1 := by
  let : TopologicalSpace Y := H.toTopologicalSpace
  have hT1 : T1Space Y := H.t1Space
  have hstrat : MSpace.IsStratifiable Y := by
    refine ⟨hT1, Proofs.L_0017.main Y ⟨g, hg_open, hg_dec, ?_⟩⟩
    intro F hF x hxF
    obtain ⟨n, m, D, hD, hdisj⟩ := hg_sep F hF x hxF
    refine ⟨n, fun hx_cl => ?_⟩
    rw [H.mem_closure_iff_hole] at hx_cl
    obtain ⟨w, hw1, hw2⟩ := hx_cl m D hD
    obtain ⟨y, hyF, hwy⟩ := mem_iUnion₂.mp hw2
    exact Set.disjoint_left.mp (hdisj y hyF) hw1 hwy
  have hnoCP : ¬ Defs.D_0001.HasCPOuterBase y₀ := by
    rintro ⟨𝓥, h𝓥_open, h𝓥_base, h𝓥_cp⟩
    have h𝓥_B : ∀ n, ∀ D ∈ H.Holes y₀, ∃ V ∈ 𝓥, V ⊆ H.W n y₀ \ D := fun n D hD =>
      h𝓥_base _ (H.isOpen_basic n y₀ hD) ⟨H.mem_W n y₀, H.not_mem_hole y₀ D hD⟩
    obtain ⟨𝒢, h𝒢sub, z, hz_hit, hz_miss⟩ := hesc 𝓥 h𝓥_open h𝓥_B
    have hz_cl : z ∈ closure (⋃₀ 𝒢) := by
      rw [H.mem_closure_iff_hole]
      intro n D hD
      obtain ⟨V, hV𝒢, w, hw1, hw2⟩ := hz_hit n D hD
      exact ⟨w, hw1, V, hV𝒢, hw2⟩
    rw [h𝓥_cp 𝒢 h𝒢sub] at hz_cl
    obtain ⟨_, ⟨V, hV𝒢, rfl⟩, hzV⟩ := hz_cl
    obtain ⟨n, D, hD, hdisj⟩ := hz_miss V hV𝒢
    rw [H.mem_closure_iff_hole] at hzV
    obtain ⟨w, hw1, hw2⟩ := hzV n D hD
    exact Set.disjoint_left.mp hdisj hw1 hw2
  have h31 : Specs.L_0031.stmt :=
    ⟨Y, H.toTopologicalSpace, hstrat, y₀,
      ⟨fun n => H.W n y₀, fun n => ⟨(H.W_clopen n y₀).1, (H.W_clopen n y₀).2, H.mem_W n y₀⟩,
        H.W_inter y₀⟩,
      hnoCP⟩
  have h30 : Specs.L_0030.stmt := Proofs.R_0010.main h31 Proofs.L_0032.main
  exact Proofs.R_0009.main Proofs.L_0029.main h30 Proofs.L_0004.main

/-- Hole-absorption stratifiability criterion:
If `g : ℕ → Y → Set Y` is a monotone open `g`-function with `g n y ⊆ H.W n y`,
and for every closed `F` and `x ∉ F` there exist `n, m` and `D' ∈ H.Holes x`
such that `∀ y ∈ F ∩ H.W m x, g n y ⊆ D'`, then `(Y, H.toTopologicalSpace)` is
stratifiable (`MSpace.IsStratifiable Y`). -/
theorem isStratifiable_of_hole_absorption
    (g : ℕ → Y → Set Y)
    (hg_open : ∀ n y, @IsOpen Y H.toTopologicalSpace (g n y) ∧ y ∈ g n y)
    (hg_dec : ∀ n y, g (n + 1) y ⊆ g n y)
    (hg_sub_W : ∀ n y, g n y ⊆ H.W n y)
    (habs : ∀ F : Set Y, @IsClosed Y H.toTopologicalSpace F → ∀ x ∉ F,
      ∃ n m, ∃ D' ∈ H.Holes x, ∀ y ∈ F ∩ H.W m x, g n y ⊆ D') :
    @MSpace.IsStratifiable Y H.toTopologicalSpace := by
  let : TopologicalSpace Y := H.toTopologicalSpace
  have hg_anti : ∀ {a b : ℕ} (y : Y), a ≤ b → g b y ⊆ g a y := by
    intro a b y hab
    induction hab with
    | refl => exact Subset.rfl
    | step _ ih => exact (hg_dec _ y).trans ih
  refine ⟨H.t1Space, Proofs.L_0017.main Y ⟨g, hg_open, hg_dec, ?_⟩⟩
  intro F hF x hxF
  obtain ⟨n, m, D', hD', hsub⟩ := habs F hF x hxF
  refine ⟨max n m, fun hx_cl => ?_⟩
  rw [H.mem_closure_iff_hole] at hx_cl
  obtain ⟨w, ⟨hwWx, hwD'⟩, hwU⟩ := hx_cl m D' hD'
  obtain ⟨y, hyF, hwy⟩ := mem_iUnion₂.mp hwU
  by_cases hyW : y ∈ H.W m x
  · exact hwD' (hsub y ⟨hyF, hyW⟩ (hg_anti y (le_max_left n m) hwy))
  · have hwyW : w ∈ H.W m y := H.W_anti (le_max_right n m) y (hg_sub_W (max n m) y hwy)
    have h1 : H.W m w = H.W m x := H.W_part m x w hwWx
    have h2 : H.W m w = H.W m y := H.W_part m y w hwyW
    exact hyW ((h1.symm.trans h2).symm ▸ H.mem_W m y)

/-- Uniform hole-absorption corollary:
If every hole `D ∈ H.Holes x` is absorbed into some `D' ∈ H.Holes x` by `g n`
at a uniform level `n`, then `(Y, H.toTopologicalSpace)` is stratifiable. -/
theorem isStratifiable_of_uniform_hole_absorption
    (g : ℕ → Y → Set Y)
    (hg_open : ∀ n y, @IsOpen Y H.toTopologicalSpace (g n y) ∧ y ∈ g n y)
    (hg_dec : ∀ n y, g (n + 1) y ⊆ g n y)
    (hg_sub_W : ∀ n y, g n y ⊆ H.W n y)
    (hunif : ∀ x, ∀ D ∈ H.Holes x, ∃ n, ∃ D' ∈ H.Holes x, ∀ y ∈ D, g n y ⊆ D') :
    @MSpace.IsStratifiable Y H.toTopologicalSpace := by
  refine H.isStratifiable_of_hole_absorption g hg_open hg_dec hg_sub_W ?_
  intro F hF x hxF
  have hopen : @IsOpen Y H.toTopologicalSpace Fᶜ := hF.isOpen_compl
  obtain ⟨m, D, hD, hsub⟩ := hopen x hxF
  obtain ⟨n, D', hD', habs⟩ := hunif x D hD
  refine ⟨n, m, D', hD', fun y ⟨hyF, hyW⟩ => ?_⟩
  have hyD : y ∈ D := by
    by_contra hyD
    exact hsub ⟨hyW, hyD⟩ hyF
  exact habs y hyD

end HoleSystem

section DefsD0007Instance

open Defs.D_0007

/-- Canonical laminar partition `W n x := H q (n + 1) (code (n + 1) (q.symm ∘ x))`
from `Defs.D_0007`, satisfying all four `HoleSystem` partition axioms. -/
def W_of_H {α : Type} (q : ℕ ≃ α) (n : ℕ) (x : ℕ → α) : Set (ℕ → α) :=
  H q (n + 1) (code (n + 1) (fun k => q.symm (x k)))

theorem W_of_H_axioms {α : Type} (q : ℕ ≃ α) :
    (∀ n x, x ∈ W_of_H q n x) ∧
    (∀ n x, W_of_H q (n + 1) x ⊆ W_of_H q n x) ∧
    (∀ n x y, y ∈ W_of_H q n x → W_of_H q n y = W_of_H q n x) ∧
    (∀ x, (⋂ n, W_of_H q n x) = {x}) := by
  refine ⟨fun _ _ => rfl, ?_, ?_, ?_⟩
  · intro n x y hy
    have hsame := (mem_H_iff_same q (n + 2) (Nat.succ_pos _) y x).mp hy
    exact (mem_H_iff_same q (n + 1) (Nat.succ_pos _) y x).mpr fun k hk => hsame k (by omega)
  · intro n x y hy
    have hsame := (mem_H_iff_same q (n + 1) (Nat.succ_pos _) y x).mp hy
    ext z
    rw [W_of_H, W_of_H, mem_H_iff_same q (n + 1) (Nat.succ_pos _) z y,
        mem_H_iff_same q (n + 1) (Nat.succ_pos _) z x]
    exact ⟨fun h k hk => (h k hk).trans (hsame k hk),
           fun h k hk => (h k hk).trans (hsame k hk).symm⟩
  · intro x
    ext y
    simp only [mem_iInter, mem_singleton_iff]
    constructor
    · intro hy
      funext k
      exact (mem_H_iff_same q (k + 1) (Nat.succ_pos k) y x).mp (hy k) k (Nat.lt_succ_self k)
    · rintro rfl n; rfl

end DefsD0007Instance

section IdealHoleConstruction

/-- Given any laminar partition `W : ℕ → Y → Set Y`, a `W`-closed subset `H₀ ⊆ Y`,
and any ideal `𝓘` of subsets of `H₀ᶜ`, carving out `D ∈ 𝓘` at points of `H₀` and
isolating points outside `H₀` defines a valid `HoleSystem Y`. -/
noncomputable def idealHoleSystem {Y : Type}
    (W : ℕ → Y → Set Y)
    (hmem : ∀ n y, y ∈ W n y)
    (hdec : ∀ n y, W (n + 1) y ⊆ W n y)
    (hpart : ∀ n x y, y ∈ W n x → W n y = W n x)
    (hinter : ∀ y, (⋂ n, W n y) = {y})
    (H₀ : Set Y)
    (𝓘 : Set (Set Y))
    (h𝓘_empty : ∅ ∈ 𝓘)
    (h𝓘_sub : ∀ D ∈ 𝓘, D ⊆ H₀ᶜ)
    (h𝓘_union : ∀ D₁ ∈ 𝓘, ∀ D₂ ∈ 𝓘, D₁ ∪ D₂ ∈ 𝓘) :
    HoleSystem Y where
  W := W
  mem_W := hmem
  W_dec := hdec
  W_part := hpart
  W_inter := hinter
  Holes := fun y => @ite _ (y ∈ H₀) (Classical.propDecidable _) 𝓘 { D | D = ∅ ∨ D = {y}ᶜ }
  empty_mem := fun y => by
    by_cases hy : y ∈ H₀ <;> simp [hy, h𝓘_empty]
  not_mem_hole := fun y D hD => by
    by_cases hy : y ∈ H₀
    · simp only [hy, ↓reduceIte] at hD
      exact fun hyD => h𝓘_sub D hD hyD hy
    · simp only [hy, ↓reduceIte, mem_ofPred_eq] at hD
      rcases hD with rfl | rfl
      · exact notMem_empty y
      · exact fun h => h rfl
  union_mem := fun y D₁ hD₁ D₂ hD₂ => by
    by_cases hy : y ∈ H₀
    · simp only [hy, ↓reduceIte] at hD₁ hD₂ ⊢
      exact h𝓘_union D₁ hD₁ D₂ hD₂
    · simp only [hy, ↓reduceIte, mem_ofPred_eq] at hD₁ hD₂ ⊢
      rcases hD₁ with rfl | rfl
      · simpa using hD₂
      · rcases hD₂ with rfl | rfl
        · exact Or.inr (union_empty _)
        · exact Or.inr (union_self _)
  coherent := fun n y D hD z ⟨hzW, hzD⟩ => by
    by_cases hz : z ∈ H₀
    · by_cases hy : y ∈ H₀
      · simp only [hy, ↓reduceIte] at hD
        refine ⟨n, le_rfl, D, by simp [hz, hD], ?_⟩
        rw [hpart n y z hzW]
      · simp only [hy, ↓reduceIte, mem_ofPred_eq] at hD
        rcases hD with rfl | rfl
        · refine ⟨n, le_rfl, ∅, by simp [hz, h𝓘_empty], ?_⟩
          rw [hpart n y z hzW]
        · have hzy : z = y := by by_contra hne; exact hzD hne
          exact (hy (hzy ▸ hz)).elim
    · refine ⟨n, le_rfl, {z}ᶜ, by simp [hz], ?_⟩
      intro w ⟨_, hwnot⟩
      have hwz : w = z := by by_contra hne; exact hwnot hne
      exact hwz ▸ ⟨hzW, hzD⟩

/-- Every `idealHoleSystem` over a `W`-closed subset `H₀` is stratifiable
(`MSpace.IsStratifiable Y`), with decreasing clopen neighborhoods `W n y`
at every point `y : Y`. -/
theorem idealHoleSystem_isStratifiable {Y : Type}
    (W : ℕ → Y → Set Y)
    (hmem : ∀ n y, y ∈ W n y)
    (hdec : ∀ n y, W (n + 1) y ⊆ W n y)
    (hpart : ∀ n x y, y ∈ W n x → W n y = W n x)
    (hinter : ∀ y, (⋂ n, W n y) = {y})
    (H₀ : Set Y)
    (hH₀_closed : ∀ x ∉ H₀, ∃ m, Disjoint (W m x) H₀)
    (𝓘 : Set (Set Y))
    (h𝓘_empty : ∅ ∈ 𝓘)
    (h𝓘_sub : ∀ D ∈ 𝓘, D ⊆ H₀ᶜ)
    (h𝓘_union : ∀ D₁ ∈ 𝓘, ∀ D₂ ∈ 𝓘, D₁ ∪ D₂ ∈ 𝓘) :
    let H := idealHoleSystem W hmem hdec hpart hinter H₀ 𝓘 h𝓘_empty h𝓘_sub h𝓘_union
    @MSpace.IsStratifiable Y H.toTopologicalSpace := by
  classical
  intro H
  let : TopologicalSpace Y := H.toTopologicalSpace
  let g : ℕ → Y → Set Y := fun n y => if y ∈ H₀ then W n y else {y}
  have hg_open : ∀ n y, IsOpen (g n y) ∧ y ∈ g n y := by
    intro n y
    dsimp only [g]
    split_ifs with hy
    · exact ⟨(H.W_clopen n y).1, hmem n y⟩
    · refine ⟨?_, rfl⟩
      have hEq : ({y} : Set Y) = W 0 y \ {y}ᶜ := by
        ext z
        simp only [mem_singleton_iff, mem_sdiff, mem_compl_iff, not_not]
        exact ⟨fun h => ⟨h ▸ hmem 0 y, h⟩, fun h => h.2⟩
      rw [hEq]
      exact H.isOpen_basic 0 y (by simp [H, idealHoleSystem, hy])
  have hg_dec : ∀ n y, g (n + 1) y ⊆ g n y := by
    intro n y
    dsimp only [g]
    split_ifs
    · exact hdec n y
    · exact Subset.rfl
  have hg_sub_W : ∀ n y, g n y ⊆ W n y := by
    intro n y
    dsimp only [g]
    split_ifs
    · exact Subset.rfl
    · exact singleton_subset_iff.mpr (hmem n y)
  refine H.isStratifiable_of_hole_absorption g hg_open hg_dec hg_sub_W ?_
  intro F hF x hxF
  by_cases hxH₀ : x ∈ H₀
  · have hopen : IsOpen Fᶜ := hF.isOpen_compl
    obtain ⟨m, D, hD, hsub⟩ := hopen x hxF
    have hD𝓘 : D ∈ 𝓘 := by simpa [H, idealHoleSystem, hxH₀] using hD
    refine ⟨0, m, D, hD, fun y ⟨hyF, hyW⟩ => ?_⟩
    have hyD : y ∈ D := by by_contra hnot; exact hsub ⟨hyW, hnot⟩ hyF
    have hy_not_H₀ : y ∉ H₀ := h𝓘_sub D hD𝓘 hyD
    dsimp only [g]
    simp only [hy_not_H₀, ↓reduceIte]
    exact singleton_subset_iff.mpr hyD
  · obtain ⟨m, hdisj⟩ := hH₀_closed x hxH₀
    refine ⟨m, m, {x}ᶜ, by simp [H, idealHoleSystem, hxH₀], fun y ⟨hyF, hyW⟩ => ?_⟩
    have hy_not_H₀ : y ∉ H₀ := fun hyH₀ => Set.disjoint_left.mp hdisj hyW hyH₀
    have hyx : y ≠ x := fun h => hxF (h ▸ hyF)
    dsimp only [g]
    simp only [hy_not_H₀, ↓reduceIte]
    exact singleton_subset_iff.mpr hyx

end IdealHoleConstruction

end Research.ChenWangHoleSystem
