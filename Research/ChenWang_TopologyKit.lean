import Targets
import Defs.D_0001
import Specs.L_0031
import Proofs.L_0004
import Proofs.L_0017
import Proofs.L_0029
import Proofs.L_0032
import Proofs.R_0009
import Proofs.R_0010

/-!
# Neighborhood-System Topology Kit for Chen–Wang Sections 6–9 (`Specs.L_0031`)

Chen–Wang (arXiv:1809.03763v2, Sections 6–7) defines the topology `τ` on `Y`
directly from a system of basic neighborhoods `B : Y → Set (Set Y)` (with holes
carved out at points of `H₀`) together with a `g`-function `g : ℕ → Y → Set Y`.

This file provides a self-contained, zero-`sorry` Lean 4 toolkit for building
`τ` from `B` and verifying `Specs.L_0031` / `¬ MSpace.Goals.Tinf_M3_imp_M1`
purely in terms of `B` and `g`:

1. `NhdSystem Y`: structure packaging a coherent neighborhood base system `B`.
2. `NhdSystem.toTopologicalSpace`: constructs `τ : TopologicalSpace Y` from `B`,
   proving `isOpen_mem`, `mem_closure_iff_base`, `not_mem_closure_iff_base`,
   and `isClosed_of_disjoint_base`.
3. `NhdSystem.isStratifiable_of_clopen_g`: derives `MSpace.IsStratifiable Y`
   directly from base-level hypotheses on `B` and `g`.
4. `NhdSystem.not_Tinf_of_clopen_g_and_base_escape`: end-to-end refutation of
   `MSpace.Goals.Tinf_M3_imp_M1` purely in terms of `NhdSystem`, `g`, and a
   base-level escape witness at `y₀`.
-/

namespace Research.ChenWangTopologyKit

open MSpace Set Topology

/-- A coherent neighborhood base system `B : Y → Set (Set Y)`. -/
structure NhdSystem (Y : Type) where
  B : Y → Set (Set Y)
  nonempty : ∀ y, (B y).Nonempty
  mem_self : ∀ y, ∀ U ∈ B y, y ∈ U
  directed : ∀ y, ∀ U ∈ B y, ∀ V ∈ B y, ∃ W ∈ B y, W ⊆ U ∩ V
  coherent : ∀ y, ∀ U ∈ B y, ∀ z ∈ U, ∃ W ∈ B z, W ⊆ U

namespace NhdSystem

variable {Y : Type} (N : NhdSystem Y)

/-- The topology `τ` generated by the neighborhood base system `N`. -/
@[instance_reducible]
def toTopologicalSpace : TopologicalSpace Y where
  IsOpen O := ∀ y ∈ O, ∃ U ∈ N.B y, U ⊆ O
  isOpen_univ := fun y _ => by
    obtain ⟨U, hU⟩ := N.nonempty y
    exact ⟨U, hU, subset_univ U⟩
  isOpen_inter := fun O₁ O₂ hO₁ hO₂ y ⟨hy1, hy2⟩ => by
    obtain ⟨U₁, hU₁, h1⟩ := hO₁ y hy1
    obtain ⟨U₂, hU₂, h2⟩ := hO₂ y hy2
    obtain ⟨W, hW, hWsub⟩ := N.directed y U₁ hU₁ U₂ hU₂
    exact ⟨W, hW, hWsub.trans (inter_subset_inter h1 h2)⟩
  isOpen_sUnion := fun F hF y ⟨O, hOF, hyO⟩ => by
    obtain ⟨U, hU, hUO⟩ := hF O hOF y hyO
    exact ⟨U, hU, hUO.trans (subset_sUnion_of_mem hOF)⟩

/-- Every basic neighborhood `U ∈ N.B y` is open in `N.toTopologicalSpace`. -/
theorem isOpen_mem {y : Y} {U : Set Y} (hU : U ∈ N.B y) :
    @IsOpen Y N.toTopologicalSpace U :=
  fun z hz => N.coherent y U hU z hz

/-- Closure characterization in terms of `N.B z`. -/
theorem mem_closure_iff_base {S : Set Y} {z : Y} :
    z ∈ @closure Y N.toTopologicalSpace S ↔ ∀ W ∈ N.B z, (W ∩ S).Nonempty := by
  let : TopologicalSpace Y := N.toTopologicalSpace
  rw [mem_closure_iff]
  constructor
  · intro h W hW
    exact h W (N.isOpen_mem hW) (N.mem_self z W hW)
  · intro h O hO hzO
    obtain ⟨W, hW, hWO⟩ := hO z hzO
    obtain ⟨w, hwW, hwS⟩ := h W hW
    exact ⟨w, hWO hwW, hwS⟩

/-- Non-closure characterization in terms of `N.B z`. -/
theorem not_mem_closure_iff_base {S : Set Y} {z : Y} :
    z ∉ @closure Y N.toTopologicalSpace S ↔ ∃ W ∈ N.B z, Disjoint W S := by
  rw [N.mem_closure_iff_base]
  push Not
  simp only [Set.disjoint_iff_inter_eq_empty]

/-- Closedness criterion in terms of `N.B`. -/
theorem isClosed_of_disjoint_base {S : Set Y}
    (h : ∀ x ∉ S, ∃ W ∈ N.B x, Disjoint W S) :
    @IsClosed Y N.toTopologicalSpace S := by
  let : TopologicalSpace Y := N.toTopologicalSpace
  rw [← isOpen_compl_iff]
  intro x hxS
  obtain ⟨W, hW, hdisj⟩ := h x hxS
  exact ⟨W, hW, hdisj.subset_compl_right⟩

/-- Base-level stratifiability criterion for `N.toTopologicalSpace`. -/
theorem isStratifiable_of_clopen_g
    (g : ℕ → Y → Set Y)
    (hg_open : ∀ n y, g n y ∈ N.B y)
    (hg_closed : ∀ n y, ∀ x ∉ g n y, ∃ W ∈ N.B x, Disjoint W (g n y))
    (hg_dec : ∀ n y, g (n + 1) y ⊆ g n y)
    (hg_inter : ∀ y, (⋂ n, g n y) = {y})
    (hg_sep : ∀ H : Set Y, @IsClosed Y N.toTopologicalSpace H → ∀ x ∉ H,
      ∃ n, ∃ U ∈ N.B x, ∀ y ∈ H, Disjoint U (g n y)) :
    @MSpace.IsStratifiable Y N.toTopologicalSpace := by
  let : TopologicalSpace Y := N.toTopologicalSpace
  have hcl : ∀ n y, IsClosed (g n y) := fun n y => N.isClosed_of_disjoint_base (hg_closed n y)
  have hT1 : T1Space Y := ⟨fun y => by
    rw [← hg_inter y]
    exact isClosed_iInter fun n => hcl n y⟩
  refine ⟨hT1, Proofs.L_0017.main Y ⟨g, fun n y => ⟨N.isOpen_mem (hg_open n y),
    N.mem_self y _ (hg_open n y)⟩, hg_dec, ?_⟩⟩
  intro H hH x hxH
  obtain ⟨n, U, hU, hdisj⟩ := hg_sep H hH x hxH
  refine ⟨n, (N.not_mem_closure_iff_base).mpr ⟨U, hU, ?_⟩⟩
  rw [Set.disjoint_left]
  intro z hzU hz_uni
  obtain ⟨y, hyH, hzy⟩ := mem_iUnion₂.mp hz_uni
  exact Set.disjoint_left.mp (hdisj y hyH) hzU hzy

/-- End-to-end `Specs.L_0031` and `¬ Tinf` criterion purely in terms of `NhdSystem` and `g`. -/
theorem not_Tinf_of_clopen_g_and_base_escape
    (g : ℕ → Y → Set Y)
    (hg_open : ∀ n y, g n y ∈ N.B y)
    (hg_closed : ∀ n y, ∀ x ∉ g n y, ∃ W ∈ N.B x, Disjoint W (g n y))
    (hg_dec : ∀ n y, g (n + 1) y ⊆ g n y)
    (hg_inter : ∀ y, (⋂ n, g n y) = {y})
    (hg_sep : ∀ H : Set Y, @IsClosed Y N.toTopologicalSpace H → ∀ x ∉ H,
      ∃ n, ∃ U ∈ N.B x, ∀ y ∈ H, Disjoint U (g n y))
    (y₀ : Y)
    (hesc : ∀ 𝓥 : Set (Set Y),
      (∀ V ∈ 𝓥, @IsOpen Y N.toTopologicalSpace V ∧ y₀ ∈ V) →
      (∀ U ∈ N.B y₀, ∃ V ∈ 𝓥, V ⊆ U) →
      ∃ 𝒢 ⊆ 𝓥, ∃ z : Y,
        (∀ W ∈ N.B z, ∃ V ∈ 𝒢, (W ∩ V).Nonempty) ∧
        (∀ V ∈ 𝒢, ∃ W ∈ N.B z, Disjoint W V)) :
    ¬ MSpace.Goals.Tinf_M3_imp_M1 := by
  let : TopologicalSpace Y := N.toTopologicalSpace
  have hstrat : MSpace.IsStratifiable Y :=
    N.isStratifiable_of_clopen_g g hg_open hg_closed hg_dec hg_inter hg_sep
  have hnoCP : ¬ Defs.D_0001.HasCPOuterBase y₀ := by
    rintro ⟨𝓥, h𝓥_open, h𝓥_base, h𝓥_cp⟩
    have h𝓥_B : ∀ U ∈ N.B y₀, ∃ V ∈ 𝓥, V ⊆ U := fun U hU =>
      h𝓥_base U (N.isOpen_mem hU) (N.mem_self y₀ U hU)
    obtain ⟨𝒢, h𝒢sub, z, hz_hit, hz_miss⟩ := hesc 𝓥 h𝓥_open h𝓥_B
    have hz_cl : z ∈ closure (⋃₀ 𝒢) := by
      rw [N.mem_closure_iff_base]
      intro W hW
      obtain ⟨V, hV𝒢, w, hwW, hwV⟩ := hz_hit W hW
      exact ⟨w, hwW, V, hV𝒢, hwV⟩
    rw [h𝓥_cp 𝒢 h𝒢sub] at hz_cl
    obtain ⟨_, ⟨V, hV𝒢, rfl⟩, hzV⟩ := hz_cl
    obtain ⟨W, hW, hdisj⟩ := hz_miss V hV𝒢
    exact (N.not_mem_closure_iff_base.mpr ⟨W, hW, hdisj⟩) hzV
  have h31 : Specs.L_0031.stmt :=
    ⟨Y, N.toTopologicalSpace, hstrat, y₀,
      ⟨fun n => g n y₀, fun n => ⟨N.isOpen_mem (hg_open n y₀),
        N.isClosed_of_disjoint_base (hg_closed n y₀),
        N.mem_self y₀ _ (hg_open n y₀)⟩, hg_inter y₀⟩,
      hnoCP⟩
  have h30 : Specs.L_0030.stmt := Proofs.R_0010.main h31 Proofs.L_0032.main
  exact Proofs.R_0009.main Proofs.L_0029.main h30 Proofs.L_0004.main

end NhdSystem

end Research.ChenWangTopologyKit
